<Window x:Class="PocketDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PocketDesk · 手机工作台" Icon="Assets/PocketDesk.ico" Style="{StaticResource {x:Type Window}}" Width="960" Height="720" MinWidth="340" MinHeight="400" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ItemsPanelTemplate x:Key="PortraitAppsPanel"><StackPanel/></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="LandscapeAppsPanel"><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
    <Style x:Key="LibraryOnly" TargetType="FrameworkElement"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded, ElementName=SettingsExpander}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="AppNavigation" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource SoftBlue}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="Padding" Value="8"/><Setter Property="MinHeight" Value="52"/><Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers><DataTrigger Binding="{Binding IsExpanded, ElementName=SettingsExpander}" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="DeviceNavigation" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="8"/><Setter Property="MinHeight" Value="52"/><Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers><DataTrigger Binding="{Binding IsExpanded, ElementName=SettingsExpander}" Value="True"><Setter Property="Background" Value="{DynamicResource SoftBlue}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="SettingCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
    <Style x:Key="SectionHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  </Window.Resources>
  <Grid x:Name="PhoneSurface">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="SideRail" Grid.RowSpan="3" Background="{DynamicResource Rail}" BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10,20,10,16">
        <StackPanel DockPanel.Dock="Top">
          <Image Source="Assets/PocketDesk.ico" Width="32" Height="32" Margin="0,0,0,26"/>
          <Button Style="{StaticResource AppNavigation}" Click="ShowLibraryPageClicked" ToolTip="应用列表" AutomationProperties.Name="应用列表" Margin="0,0,0,8"><StackPanel><TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="应用" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></Button>
          <Button Style="{StaticResource DeviceNavigation}" Click="ShowPhoneSettingsClicked" ToolTip="设备与设置" AutomationProperties.Name="设备与设置"><StackPanel><TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="设备" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></Button>
        </StackPanel>
        <TextBlock Text="PD" Foreground="{DynamicResource Muted}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
      </DockPanel>
    </Border>
    <Grid x:Name="MainPane" Grid.Column="1" Margin="24,20,24,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="HeaderBar" Margin="0,0,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
          <TextBlock x:Name="PageTitle" FontSize="24" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="应用"/><Style.Triggers><DataTrigger Binding="{Binding IsExpanded, ElementName=SettingsExpander}" Value="True"><Setter Property="Text" Value="设备"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <TextBlock x:Name="HeaderSubtitle" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="选择窗口，继续工作"/><Style.Triggers><DataTrigger Binding="{Binding IsExpanded, ElementName=SettingsExpander}" Value="True"><Setter Property="Text" Value="连接、显示与外观"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="RotateButton" Content="旋转" BorderThickness="0" MinWidth="60" Padding="12,8" Margin="0,0,8,0" Background="{DynamicResource Fill}" IsEnabled="False" Click="RotateClicked" ToolTip="横竖屏切换 · Ctrl + Alt + F11" AutomationProperties.Name="旋转设备屏幕"/>
          <Button x:Name="WorkspaceButton" Content="进入工作台" BorderThickness="0" MinWidth="108" Padding="14,8" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" Click="EnterClicked"/>
        </StackPanel>
      </Grid>
      <Border x:Name="ConnectionBanner" Grid.Row="1" Background="{DynamicResource Card}" CornerRadius="16" Padding="14,8" Margin="0,0,0,16">
        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=PreviewPanel}" Value="Visible"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=PhoneSurface}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <Grid MinHeight="40"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
          <TextBlock x:Name="ConnectionTitle" Grid.Column="1" Text="等待设备超级屏接入" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Button Grid.Column="2" Content="还原" BorderThickness="0" MinHeight="44" Padding="12,6" Background="Transparent" Foreground="{DynamicResource Muted}" Click="FinishClicked" ToolTip="结束工作台并还原窗口与分辨率" AutomationProperties.Name="结束并还原"/>
        </Grid>
      </Border>
      <Border x:Name="PreviewPanel" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource WarningBackground}" CornerRadius="16" Padding="16" Margin="0,0,0,14">
        <StackPanel><TextBlock x:Name="PreviewText" Text="确认屏幕显示正常" FontSize="14" Foreground="{DynamicResource WarningText}"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="保留" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" Click="KeepModeClicked" Margin="0,0,4,0"/><Button Grid.Column="1" Content="立即回退" Click="RevertModeClicked" Margin="4,0,0,0"/></Grid></StackPanel>
      </Border>
      <Border x:Name="SearchCard" Grid.Row="3" Background="{DynamicResource Fill}" CornerRadius="14" Margin="0,0,0,18" MinHeight="48">
        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded, ElementName=SettingsExpander}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Visibility, ElementName=PreviewPanel}" Value="Visible"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
          <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" FontSize="14" Padding="0,0,4,0" TextChanged="SearchChanged" AutomationProperties.Name="搜索应用或窗口"/>
          <TextBlock Grid.Column="1" Text="搜索应用或窗口" Foreground="{DynamicResource Placeholder}" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Padding="0" Background="Transparent" BorderThickness="0" Click="ClearSearchClicked" ToolTip="清空搜索" AutomationProperties.Name="清空搜索"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
        </Grid>
      </Border>
      <ScrollViewer x:Name="LibraryScroll" Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel>
          <StackPanel Style="{StaticResource LibraryOnly}">
            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="运行中的应用" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="WindowCount" Grid.Column="1" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Grid>
            <TextBlock x:Name="EmptyText" Text="没有找到窗口，换个关键词试试。" Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,24,0,24" Visibility="Collapsed"/>
            <ItemsControl x:Name="WindowList" Margin="-6,0,-6,0"><ItemsControl.ItemTemplate><DataTemplate>
              <Border Background="{DynamicResource Card}" CornerRadius="20" Margin="6,0,6,12" ClipToBounds="True">
                <StackPanel>
                  <Grid Margin="16,16,16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid Width="36" Height="36"><Border Background="{DynamicResource Fill}" CornerRadius="10"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Muted}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border><Image Source="{Binding Icon}" Width="36" Height="36" Stretch="Uniform"/></Grid>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding AppName}" FontSize="16" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/></StackPanel>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Windows}"><ItemsControl.ItemTemplate><DataTemplate>
                    <StackPanel><Border Background="{DynamicResource Separator}" Height="1" Margin="16,0"/>
                      <Button Click="OpenWindowClicked" Tag="{Binding}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="16,10" MinHeight="52" AutomationProperties.Name="{Binding Title}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Grid.Column="1" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
                      </Button>
                    </StackPanel>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>
          <Expander x:Name="SettingsExpander" IsExpanded="False" Foreground="{DynamicResource PrimaryText}">
            <Expander.Template><ControlTemplate TargetType="Expander"><ContentPresenter x:Name="SettingsContent" Visibility="Collapsed"/><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="SettingsContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Expander.Template>
            <Grid x:Name="SettingsLayout">
              <Grid.ColumnDefinitions><ColumnDefinition x:Name="SettingsLeftColumn"/><ColumnDefinition x:Name="SettingsRightColumn" Width="0"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border x:Name="ProfileCard" Style="{StaticResource SettingCard}"><StackPanel><TextBlock Text="设备配置" Style="{StaticResource SectionHeading}"/><TextBlock x:Name="PhoneProfileText" Text="设备配置" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="DeviceDetectionText" Text="正在读取 UU 当前控制设备…" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
              <Border x:Name="ConnectionCard" Grid.Row="1" Style="{StaticResource SettingCard}"><StackPanel><TextBlock Text="自动适配" Style="{StaticResource SectionHeading}"/><CheckBox x:Name="AutoFollowBox" IsChecked="True" Click="AutoFollowChanged"><TextBlock Text="识别手机和平板" FontSize="14"/></CheckBox><TextBlock Text="从 UU 的当前连接识别设备。无法识别时，请打开 UU 主窗口。" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,2,0,10"/><Border Height="1" Background="{DynamicResource Separator}"/><CheckBox x:Name="PortraitOnConnectBox" IsChecked="True" Click="PortraitOnConnectChanged"><TextBlock Text="接入时优先竖屏" FontSize="14"/></CheckBox></StackPanel></Border>
              <Border x:Name="DisplayCard" Grid.Row="2" Style="{StaticResource SettingCard}"><StackPanel><TextBlock Text="显示与方向" Style="{StaticResource SectionHeading}"/><TextBlock x:Name="DisplayDetail" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionHint" Text="在 UU 中开启超级屏。" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/><Button Content="切换横屏 / 竖屏" IsEnabled="{Binding IsEnabled, ElementName=RotateButton}" Click="RotateClicked" Background="{DynamicResource SoftBlue}" Foreground="{DynamicResource Accent}" Margin="0,14,0,0"/><TextBlock Text="也可使用顶部“旋转”或 Ctrl + Alt + F11。" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/><Border Height="1" Background="{DynamicResource Separator}" Margin="0,16,0,8"/>
<CheckBox x:Name="ReserveUuToolbarBox" IsChecked="True" Click="ViewportPreferenceChanged"><TextBlock Text="画面适配 UU 工具栏" FontSize="14"/></CheckBox>
<TextBlock Text="调整整个桌面的分辨率比例，让任务栏也能点到。点按错位时，请在 UU 重新选择超级屏。" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,2,0,12"/>
<TextBlock Text="横屏工具栏位置" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
<ComboBox x:Name="LandscapeToolbarPicker" SelectedIndex="2" SelectionChanged="LandscapeToolbarChanged" IsEnabled="{Binding IsChecked, ElementName=ReserveUuToolbarBox}" AutomationProperties.Name="横屏 UU 工具栏位置"><ComboBoxItem Content="底部"/><ComboBoxItem Content="左侧"/><ComboBoxItem Content="右侧"/><ComboBoxItem Content="已收起，不留空"/></ComboBox></StackPanel></Border>
              <Border x:Name="AppearanceCard" Grid.Row="3" Style="{StaticResource SettingCard}"><StackPanel><TextBlock Text="外观" Style="{StaticResource SectionHeading}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="SystemThemeButton" Content="自动" Tag="System" Padding="4,8" Margin="0,0,4,0" Click="ThemeClicked" ToolTip="跟随 Windows 外观"/><Button x:Name="LightThemeButton" Grid.Column="1" Content="浅色" Tag="Light" Padding="4,8" Margin="2,0" Click="ThemeClicked"/><Button x:Name="DarkThemeButton" Grid.Column="2" Content="深色" Tag="Dark" Padding="4,8" Margin="4,0,0,0" Click="ThemeClicked"/></Grid><TextBlock x:Name="ThemeHint" Text="选择会自动保存" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
              <Border x:Name="AdvancedCard" Grid.Row="4" Style="{StaticResource SettingCard}"><StackPanel><TextBlock Text="手动显示设置" Style="{StaticResource SectionHeading}"/><TextBlock Text="目标显示器" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/><ComboBox x:Name="DisplayPicker" DisplayMemberPath="Label" SelectionChanged="DisplayChanged" AutomationProperties.Name="目标显示器"/><Button Content="刷新显示器与窗口" Style="{StaticResource NavigationButton}" Click="RefreshClicked" HorizontalAlignment="Left" Padding="0,8" Margin="0,2,0,10"/><TextBlock Text="分辨率" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/><ComboBox x:Name="ModePicker" DisplayMemberPath="Label" AutomationProperties.Name="分辨率"/><Button x:Name="ApplyModeButton" Content="试用此分辨率" Click="ApplyModeClicked" Background="{DynamicResource SoftBlue}" Foreground="{DynamicResource Accent}" Margin="0,12,0,0"/><TextBlock Text="试用后 15 秒内确认，未确认会自动回退。应用窗口有最小尺寸限制时，可能无法完整铺入较窄的屏幕。" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
            </Grid>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border x:Name="BottomNavigation" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" Background="{DynamicResource Rail}" BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0" Padding="12,6">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Style="{StaticResource AppNavigation}" Click="ShowLibraryPageClicked" AutomationProperties.Name="应用列表" Margin="0,0,6,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="应用" FontSize="14" VerticalAlignment="Center"/></StackPanel></Button><Button Grid.Column="1" Style="{StaticResource DeviceNavigation}" Click="ShowPhoneSettingsClicked" AutomationProperties.Name="设备与设置" Margin="6,0,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="设备" FontSize="14" VerticalAlignment="Center"/></StackPanel></Button></Grid>
    </Border>
    <StackPanel Grid.Column="1" Grid.Row="2" Margin="16,4,16,8"><TextBlock x:Name="StatusText" Text="就绪 · Ctrl + Alt + F12 返回应用" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" MaxHeight="32" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><Button x:Name="ManualZoomButton" Content="已手动恢复字号" Visibility="Collapsed" Click="ManualZoomClicked" Margin="0,6,0,0"/></StackPanel>
  </Grid>
</Window>
