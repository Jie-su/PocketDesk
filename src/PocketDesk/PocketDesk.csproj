<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/PocketDesk.ico</ApplicationIcon>
    <AssemblyName>PocketDesk</AssemblyName>
    <Version>0.2.1</Version>
    <AssemblyVersion>0.2.1.0</AssemblyVersion>
    <FileVersion>0.2.1.0</FileVersion>
    <Authors>Jie-su</Authors>
    <Description>Windows companion for a phone or tablet workspace over a UU virtual display.</Description>
    <RepositoryUrl>https://github.com/Jie-su/PocketDesk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Jie-su/PocketDesk</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Product>PocketDesk · UU 手机工作台</Product>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/PocketDesk.ico" />
  </ItemGroup>
</Project>
