<UserControl x:Class="PocketDesk.AppPoolPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <DockPanel LastChildFill="True">
      <Button x:Name="Add" Content="添加" DockPanel.Dock="Right" MinWidth="48" MinHeight="44" Padding="8,4" Click="Add_Click"/>
      <Button x:Name="Manage" Content="管理" DockPanel.Dock="Right" MinWidth="48" MinHeight="44" Margin="0,0,4,0" Padding="8,4" Click="Manage_Click"/>
      <TextBlock Text="常用应用" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
    </DockPanel>
    <TextBlock x:Name="Hint" Margin="0,5,0,6" Foreground="{DynamicResource Muted}" FontSize="12"/>
    <TextBlock x:Name="Message" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"
               TextWrapping="Wrap" Foreground="{DynamicResource WarningText}" Margin="0,0,0,6"/>
    <StackPanel x:Name="Pins">
      <ItemsControl x:Name="PinnedList">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,2,4,2">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button Click="Launch_Click" ToolTip="{Binding App.ExecutablePath}" AutomationProperties.Name="{Binding App.Name}"
                      HorizontalContentAlignment="Stretch" Padding="10,4">
                <DockPanel LastChildFill="True">
                  <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0"/>
                  <TextBlock Text="{Binding App.Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Grid.Column="1" Content="移除" Click="Remove_Click" Padding="8,4" Margin="4,0,0,0"
                      AutomationProperties.Name="{Binding App.Name, StringFormat=移除 {0}}"
                      Visibility="{Binding RemoveVisibility}"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button x:Name="MorePins" Visibility="Collapsed" HorizontalAlignment="Stretch" MinHeight="44" Click="MorePins_Click"/>
    </StackPanel>
    <StackPanel x:Name="Running" Visibility="Collapsed" Margin="0,10,0,0">
      <Border Height="1" Background="{DynamicResource Separator}" Margin="0,0,0,5"/>
      <DockPanel>
        <Button x:Name="RefreshWindowsButton" DockPanel.Dock="Right" Content="刷新" MinHeight="44" MinWidth="48" Padding="8,4"
                AutomationProperties.Name="刷新运行中窗口" Click="RefreshWindows_Click"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="运行中的窗口" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
          <TextBlock x:Name="RunningSummary" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </DockPanel>
      <TextBox x:Name="WindowFilter" Visibility="Collapsed" MinHeight="34" VerticalContentAlignment="Center" Margin="0,2,0,4"
               ToolTip="按窗口标题或应用名搜索" AutomationProperties.Name="搜索窗口标题或应用名" TextChanged="WindowFilter_Changed"/>
      <ItemsControl x:Name="RunningList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Click="SwitchWindow_Click" ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title, StringFormat=切换到 {0}}"
                    MinHeight="44" HorizontalContentAlignment="Stretch" Padding="8,3" Margin="0,2">
              <DockPanel>
                <TextBlock Text="›" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="{DynamicResource Accent}"/>
                <StackPanel>
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                  <TextBlock Text="{Binding ProcessName}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DockPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button x:Name="MoreWindows" Visibility="Collapsed" MinHeight="44" HorizontalAlignment="Stretch" Click="MoreWindows_Click"/>
    </StackPanel>
    <StackPanel x:Name="Chooser" Visibility="Collapsed" Margin="0,4,0,0">
      <Button x:Name="Browse" Content="浏览本地 .exe…" Click="Browse_Click" Padding="8,4"/>
      <TextBlock Text="或从已注册的程序中添加" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,3"/>
      <TextBox x:Name="Query" AutomationProperties.Name="搜索已安装程序" ToolTip="搜索程序名称" TextChanged="Query_Changed"/>
      <TextBlock x:Name="Matches" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3"/>
      <ItemsControl x:Name="Candidates">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Click="Pin_Click" ToolTip="{Binding ExecutablePath}" Margin="0,2" Padding="8,4"
                    AutomationProperties.Name="{Binding Name, StringFormat=添加 {0}}" HorizontalContentAlignment="Stretch">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="＋" Foreground="{DynamicResource Accent}"/>
                <TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
