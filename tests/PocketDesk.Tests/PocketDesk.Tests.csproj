<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup Condition="'$(NativeOnly)' != 'true'">
    <ProjectReference Include="../../src/PocketDesk/PocketDesk.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(NativeOnly)' == 'true'">
    <Compile Include="../../src/PocketDesk/Native/*.cs" Link="Native/%(Filename)%(Extension)" />
    <Compile Include="../../src/PocketDesk/MobileGestureLayer.cs" Link="MobileGestureLayer.cs" />
    <Compile Include="../../src/PocketDesk/Core/MobileGesturePolicy.cs" Link="Core/MobileGesturePolicy.cs" />
    <Compile Include="../../src/PocketDesk/Core/MobileAutoZoomPolicy.cs" Link="Core/MobileAutoZoomPolicy.cs" />
    <Compile Include="../../src/PocketDesk/Core/RecoveryStore.cs" Link="Core/RecoveryStore.cs" />
    <Compile Include="../../src/PocketDesk/Core/AppPoolStore.cs" Link="Core/AppPoolStore.cs" />
    <Compile Include="../../src/PocketDesk/Core/WorkspaceSession.cs" Link="Core/WorkspaceSession.cs" />
    <Compile Include="../../src/PocketDesk/Core/AutoWorkspacePolicy.cs" Link="Core/AutoWorkspacePolicy.cs" />
    <Compile Include="../../src/PocketDesk/Core/PortraitModePolicy.cs" Link="Core/PortraitModePolicy.cs" />
    <Compile Include="../../src/PocketDesk/Core/AutoPortraitAttemptPolicy.cs" Link="Core/AutoPortraitAttemptPolicy.cs" />
    <Compile Include="../../src/PocketDesk/Core/PhoneProfileStore.cs" Link="Core/PhoneProfileStore.cs" />
    <Compile Include="../../src/PocketDesk/Core/PhoneSessionPolicy.cs" Link="Core/PhoneSessionPolicy.cs" />
    <Compile Include="../../src/PocketDesk/Core/RotationModePolicy.cs" Link="Core/RotationModePolicy.cs" />
    <Compile Include="../../src/PocketDesk/Core/DeviceProfileCatalog.cs" Link="Core/DeviceProfileCatalog.cs" />
    <Compile Include="../../src/PocketDesk/Core/DeviceModePolicy.cs" Link="Core/DeviceModePolicy.cs" />
    <Compile Include="../../src/PocketDesk/Core/DeviceSessionPolicy.cs" Link="Core/DeviceSessionPolicy.cs" />
    <Compile Include="../../src/PocketDesk/Core/ToolbarLayout.cs" Link="Core/ToolbarLayout.cs" />
    <Compile Include="../../src/PocketDesk/Core/PhoneViewportPolicy.cs" Link="Core/PhoneViewportPolicy.cs" />
    <Compile Include="../../src/PocketDesk/Core/ViewportPreferenceStore.cs" Link="Core/ViewportPreferenceStore.cs" />
    <Compile Include="../../src/PocketDesk/Core/ControllerHandoverPolicy.cs" Link="Core/ControllerHandoverPolicy.cs" />
    <Compile Include="../../src/PocketDesk/Core/ControllerDisconnectPolicy.cs" Link="Core/ControllerDisconnectPolicy.cs" />
    <Compile Include="../../src/PocketDesk/Core/AutomaticRecoveryEvidencePolicy.cs" Link="Core/AutomaticRecoveryEvidencePolicy.cs" />
    <Compile Include="../../src/PocketDesk/Core/PhoneScreenGeometry.cs" Link="Core/PhoneScreenGeometry.cs" />
  </ItemGroup>
</Project>
